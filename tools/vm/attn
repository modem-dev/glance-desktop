#!/bin/sh
# A stand-in for attn inside the VM: prints what cmd/attn/send_stack_test.go and
# cmd/attnd/model_call_stack_test.go in attn pin, and keeps each send's arguments and
# files in ~/lens-check/sent.
sent="$HOME/lens-check/sent"
mkdir -p "$sent"
# attn model call --token-stdin: the token, then one JSON request, on stdin; Lens's
# input is {"transcript":...}, with screen_words and maybe_misheard when a dictation
# had them; model-request keeps the whole request. Answers after a second, as a quick refinement would,
# so the pill's wait shows in a recording.
if [ "$1" = model ]; then
    request="$(tail -n +2)"
    printf '%s\n' "$*" >"$sent/model-args"
    printf '%s\n' "$request" >"$sent/model-request"
    raw="$(printf '%s' "$request" | /usr/bin/python3 -I -c 'import json,sys; print(json.loads(json.load(sys.stdin)["input"])["transcript"])')"
    sleep 1
    printf '%s' "$raw" | /usr/bin/python3 -I -c 'import json,sys; print(json.dumps({"harness":"claude","model":"sonnet","model_ms":1000,"text":"Refined: "+sys.stdin.read()}))'
    exit 0
fi
[ "$1" = send ] || {
    echo "stand-in attn: only send and model call are known" >&2
    exit 2
}
shift
case "$1" in
sessions)
    cat >/dev/null
    echo '[{"agent":"claude","id":"vm-target","label":"VM stand-in","last_focused_at":"2026-11-07T00:00:00Z","state":"idle"}]'
    ;;
pair)
    echo '{"id":"p1","name":"Attn Lens","code":"0420","requested_at":"2026-11-07T00:00:00Z"}'
    echo '{"sender":{"id":"x","name":"Attn Lens","created_at":"2026-11-07T00:00:00Z"},"token":"vm-stand-in-token"}'
    ;;
*)
    cat >/dev/null
    dir="$(mktemp -d "$sent/XXXXXX")"
    printf '%s\n' "$*" >"$dir/args"
    while [ $# -gt 0 ]; do
        if [ "$1" = --file ]; then
            cp "$2" "$dir/" || exit 1
        fi
        shift
    done
    echo '{"id":"cap","attachments":[]}'
    ;;
esac
