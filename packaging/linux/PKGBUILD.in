# Generated by scripts/package-linux.sh from the archive built beside this file.
pkgname=glance-desktop
pkgver=@VERSION@
pkgrel=1
pkgdesc='Native screenshot editor with annotations, animated backdrops, and sharing'
arch=('@ARCH@')
url='https://github.com/modem-dev/glance-desktop'
license=('MIT')
depends=('gcc-libs' 'glibc' 'fontconfig' 'freetype2' 'libx11' 'libxcb'
         'libxkbcommon' 'libxkbcommon-x11' 'wayland' 'vulkan-icd-loader'
         'xdg-utils' 'ttf-dejavu' 'grim' 'slurp' 'wl-clipboard' 'zenity' 'ffmpeg')
optdepends=('tesseract: offline text extraction'
            'tesseract-data-eng: English text recognition data')
options=('!strip')
source=('@ARCHIVE@')
sha256sums=('@SHA256@')

package() {
    cd "$srcdir/@DIRECTORY@"
    install -d "$pkgdir/usr/lib/glance/bin" "$pkgdir/usr/bin"
    install -m755 bin/* "$pkgdir/usr/lib/glance/bin/"
    ln -s ../lib/glance/bin/glance "$pkgdir/usr/bin/glance"
    install -Dm644 share/applications/glance.desktop "$pkgdir/usr/share/applications/glance.desktop"
    install -Dm644 share/icons/hicolor/scalable/apps/glance.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/glance.svg"
    install -d "$pkgdir/usr/share/licenses/glance-desktop"
    install -m644 share/licenses/glance/* "$pkgdir/usr/share/licenses/glance-desktop/"
}
